PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/claimassist
JWT_SECRET=replace-this-with-a-long-random-string

AI_SERVICE_URL=http://127.0.0.1:8000
CLIENT_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Never commit a real key. Leave blank to use the deterministic mock LLM
# provider (ai-service/.env LLM_PROVIDER=mock), which keeps the whole demo
# fully runnable offline.
LLM_API_KEY=
